# Local development defaults. Copy to .env and replace SECRET_KEY.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: configure for AI chat replies. Keep this key server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional SMTP settings. Without these, email is printed in the server console.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=MediCore <noreply@example.com>

# Optional demo-only seeding password. Do not seed demo accounts in production.
# DEMO_PASSWORD=
